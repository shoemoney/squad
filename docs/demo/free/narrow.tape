Output "/tmp/squad-demo/free-narrow.mp4"
Set Shell "bash"
Set FontSize 14
Set Width 800
Set Height 450
Set Padding 10
Set Theme "Catppuccin Mocha"
Set WindowBar Colorful
Hide
Type "unset NO_COLOR; export TERM=xterm-256color; clear"
Enter
Show
Type "target/release/examples/demo"
Enter
Sleep 62s
Type "q"
Sleep 1s
