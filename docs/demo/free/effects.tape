Output "/tmp/squad-demo/free-fx.mp4"
Set Shell "bash"
Set FontSize 14
Set Width 1400
Set Height 860
Set Padding 10
Set Theme "Catppuccin Mocha"
Set WindowBar Colorful
Hide
Type "unset NO_COLOR; export TERM=xterm-256color; clear"
Enter
Show
Type "target/release/examples/fx_reel"
Enter
Sleep 26s
Type "q"
Sleep 1s
