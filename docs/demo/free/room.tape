Output "/tmp/squad-demo/free-demo-full.mp4"
Set Shell "bash"
Set FontSize 14
Set Width 1400
Set Height 860
Set Padding 12
Set Theme "Catppuccin Mocha"
Set WindowBar Colorful
Hide
Type "unset NO_COLOR; export TERM=xterm-256color; clear"
Enter
Show
Type "target/release/examples/demo"
Enter
Sleep 100s
Type "q"
Sleep 1s
