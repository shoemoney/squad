# Squad configuration. Copy to .env and add your key.

# Required. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Debate length: rounds per $debate (1 to 20). Change per room at runtime with $ROUNDS=5 or /set ROUNDS 5.
SQUAD_ROUNDS=10

# Daily spending cap in US dollars. Squad stops sending new requests when today's spend reaches it.
SQUAD_DAILY_MAX_USD=20

# Grill length: rounds per $grill (1 to 10). Change per room at runtime with $GRILL_ROUNDS=2 or /set GRILL_ROUNDS 2.
SQUAD_GRILL_ROUNDS=2

# The room. One line per member: SQUAD_MODEL_<NICK>=<OpenRouter model slug>.
# The nick is the lowercase of <NICK> and is what you type after @.
# Slugs starting with ~ are OpenRouter "latest" aliases and follow new releases automatically.
# Add a line to add a member (up to 12), delete a line to remove one.
SQUAD_MODEL_CLAUDE=~anthropic/claude-opus-latest
SQUAD_MODEL_FABLE=~anthropic/claude-fable-latest
SQUAD_MODEL_OPENAI=~openai/gpt-sol-latest
SQUAD_MODEL_GEMINI=google/gemini-4-neon
SQUAD_MODEL_GROK=~x-ai/grok-latest
SQUAD_MODEL_MUSE=meta/muse-wonder

# The judge is summoned, never a room member. Uses Fable by default.
SQUAD_JUDGE_MODEL=~anthropic/claude-fable-latest

# Optional settings. Each line below is commented out, so the built-in default applies.
# Remove the leading # to change a value. Process environment variables override this file.

# OpenRouter API base URL. Keep the trailing slash.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/

# Fallback judge nicks, in order, when the judge model conflicts with a debate.
# SQUAD_JUDGE_FALLBACKS=claude,openai

# Effort for final judge calls: low, medium or high.
# SQUAD_JUDGE_REASONING_EFFORT=high

# Persona text for one member. Replace <NICK> with the member's nick in capitals.
# SQUAD_PERSONA_CLAUDE=

# Default reasoning effort for members: low, medium or high.
# SQUAD_REASONING_EFFORT=medium

# Effort override for one member. Replace <NICK> with the member's nick in capitals.
# SQUAD_REASONING_EFFORT_CLAUDE=low

# Name used in prompts. You are still "me" in the interface. Must not be empty.
# SQUAD_USER_NAME=the user

# Seeds the stored CENSUS_PASSES (1 to 5) when none is stored.
# SQUAD_CENSUS_PASSES=2

# Estimated cost in US dollars above which Squad asks you to confirm a debate. 0 or more.
# SQUAD_DEBATE_CONFIRM_USD=2

# How long alias resolutions are reused, in seconds. 0 forces a refresh.
# SQUAD_ALIAS_CACHE_TTL_SECONDS=86400

# Word limit for the room prompt. Must be a positive integer.
# SQUAD_ROOM_WORDS=500

# Word limit for debate turns and grill answers.
# SQUAD_TURN_WORDS=400

# Word limit for the final debate turn.
# SQUAD_FINAL_TURN_WORDS=500

# Word limit for rebuilt grill plans.
# SQUAD_PLAN_WORDS=1200

# Directory of prompt templates to use instead of the built-in ones.
# SQUAD_PROMPTS_DIR=

# Where the database, cache and logs live. --data-dir overrides it.
# SQUAD_DATA_DIR=

# Log level: trace, debug, info, warn, error or off.
# SQUAD_LOG_LEVEL=info

# Any non-empty value turns colour off.
# NO_COLOR=1

# Contest banners: on, compact or off.
# SQUAD_BANNERS=on

# Animation level: full, lite or off.
# SQUAD_FX=full

# Set to 1 to show the effects-grade tag.
# SQUAD_FX_DEBUG=1
